# --- database ---
# POSTGRES_PORT only affects docker-compose.dev.yml; change both if 5432 is taken
POSTGRES_PORT=5432
DATABASE_URL=postgres://sentrello:sentrello@localhost:5432/sentrello

# --- licensing (public key is embedded; path is for the instance to read it) ---
SENTRELLO_LICENSE_PUBLIC_KEY_PATH=./secrets/license_public.pem
SENTRELLO_LICENSE_TOKEN_PATH=./secrets/license_token.jwt
SENTRELLO_LICENSE_SERVER_URL=https://sentrello.com   # used for daily refresh (Packet 03)

# --- instance ---
SENTRELLO_INSTANCE_ID=dev-instance
PORT=3000

# --- auth ---
BETTER_AUTH_SECRET=change-me-32-bytes-min
SENTRELLO_BASE_URL=http://localhost:3000
# optional BYO Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- email (Resend OR SMTP_*) ---
RESEND_API_KEY=
EMAIL_FROM="Sentrello <billing@yourbiz.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- license refresh (Packet 03 endpoint) ---
SENTRELLO_LICENSE_KEY=

# --- sign-up policy ---
# Unset (the default) means: only the first-run owner or an invited address may
# create an account. Set to true only if you want open registration.
SENTRELLO_ALLOW_SIGNUP=
